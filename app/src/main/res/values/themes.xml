<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- Dedicated Splash Screen Theme using Android 12+ Splash Screen API -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background color to Mkulima Deep Forest Green -->
        <item name="windowSplashScreenBackground">#0D3B23</item>
        <!-- Set the splash screen icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#0D3B23</item>
        <!-- Theme to switch to after splash screen exits -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
